# LLM（环境变量优先于 config.py）
LLM_API_KEY=
LLM_MODEL_NAME=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# Mem0
MEM0_API_KEY=
MEM0_ENABLED=1

# API（未设置则不校验 X-API-Key）
APP_API_KEY=

# HuggingFace
HF_HOME=/app/.cache/huggingface
HF_ENDPOINT=https://hf-mirror.com

# CORS（* 或逗号分隔）
CORS_ORIGINS=*
